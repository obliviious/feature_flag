{
  "name": "@flagforge/sdk-js",
  "version": "0.3.0",
  "description": "FlagForge JavaScript/TypeScript SDK — local evaluation + real-time streaming",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "flagforge",
    "flags",
    "sdk",
    "evaluation",
    "targeting",
    "rollout",
    "sse",
    "real-time"
  ],
  "author": "FlagForge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/obliviious/feature_flag",
    "directory": "sdks/js"
  },
  "homepage": "https://github.com/obliviious/feature_flag/tree/main/sdks/js",
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
