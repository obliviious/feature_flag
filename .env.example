DATABASE_URL=sqlite://flagforge.db?mode=rwc
REDIS_URL=redis://localhost:6379
CLERK_DOMAIN=your-app.clerk.accounts.dev
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# OpenTelemetry → Grafana (optional; see deploy/grafana-otel.md)
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=flagforge-server
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
# Easiest auth (from Grafana Cloud → OpenTelemetry tile):
# GRAFANA_CLOUD_INSTANCE_ID=1234567
# GRAFANA_CLOUD_OTLP_TOKEN=glc_...
# Or manual header:
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic BASE64_INSTANCE_ID_COLON_TOKEN
